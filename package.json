{
    "name": "bark-jm",
    "description": "Bark push notification server on Cloudflare Workers, deployed at bark.jmlapido.com",
    "type": "module",
    "private": true,
    "devDependencies": {
        "wrangler": "^4.84.1"
    },
    "scripts": {
        "cf-typegen": "wrangler types",
        "db:create": "wrangler d1 create bark-jm-db",
        "db:migrate": "wrangler d1 migrations apply database --local",
        "db:migrate:remote": "wrangler d1 migrations apply database --remote",
        "deploy": "wrangler deploy",
        "dev": "wrangler dev",
        "predeploy": "npm run db:migrate:remote",
        "preview": "wrangler dev"
    }
}
